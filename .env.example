# --- ClickHouse Telemetry Database ---
CLICKHOUSE_HOST=your-cluster-id.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# --- Google Gemini Enterprise AI ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- FastAPI Backend Server Settings ---
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://backlot-ui.vercel.app

# --- Next.js Frontend Connection ---
NEXT_PUBLIC_API_URL=http://localhost:8000